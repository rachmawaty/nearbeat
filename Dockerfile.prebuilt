# Runtime-only image: run `npm run build` locally first (the 1.9GB droplet is
# OOM-killed building the frontend). Ships dist/ plus the Express server.
FROM node:20-slim
WORKDIR /app
ENV NODE_ENV=production PORT=3000
COPY dist ./dist
COPY server/package.json server/package-lock.json ./server/
WORKDIR /app/server
RUN npm ci --omit=dev
WORKDIR /app
COPY server/ ./server/
EXPOSE 3000
CMD ["node", "server/index.js"]
